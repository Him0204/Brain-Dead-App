<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Game3">

    <include
        layout="@layout/game_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/textView_insomnia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:layout_centerHorizontal="true"
        android:text="3. Make him fall asleep"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/imageButton_insomnia"
        android:layout_width="230dp"
        android:layout_height="250dp"
        android:layout_centerInParent="true"
        android:layout_centerVertical="true"
        android:background="?android:attr/activatedBackgroundIndicator"
        android:focusable="true"
        android:scaleType="fitCenter"
        android:src="@drawable/g3_insomnia"
        android:visibility="visible" />

    <ImageButton
        android:id="@+id/imageButton_aromatherapy"
        android:layout_width="50dp"
        android:layout_height="130dp"
        android:layout_alignParentStart="false"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="294dp"
        android:layout_marginTop="463dp"
        android:layout_marginEnd="30dp"
        android:background="?android:attr/activatedBackgroundIndicator"
        android:scaleType="fitCenter"
        android:src="@drawable/g3_aromatherapy" />

    <ImageButton
        android:id="@+id/imageButton_sleeping"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_centerInParent="true"
        android:layout_centerVertical="true"
        android:background="?android:attr/activatedBackgroundIndicator"
        android:focusable="false"
        android:scaleType="fitCenter"
        android:src="@drawable/g3_sleeping"
        android:visibility="invisible" />

    <ImageButton
        android:id="@+id/imageButton_mp3"
        android:layout_width="100dp"
        android:layout_height="90dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="false"
        android:layout_alignParentBottom="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="49dp"
        android:layout_marginEnd="128dp"
        android:layout_marginBottom="180dp"
        android:background="?android:attr/activatedBackgroundIndicator"
        android:scaleType="fitCenter"
        android:src="@drawable/g3_mp3" />

    <ImageButton
        android:id="@+id/imageButton_milk"
        android:layout_width="100dp"
        android:layout_height="130dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="false"
        android:layout_alignParentBottom="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="198dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="100dp"
        android:background="?android:attr/activatedBackgroundIndicator"
        android:scaleType="fitCenter"
        android:src="@drawable/g3_milk" />

</RelativeLayout>