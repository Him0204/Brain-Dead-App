<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.sensor.light"
        android:required="true" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/game_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/game_round_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.SEHH3165_GP" >
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".LoginPage"
            android:exported="true" />
        <activity android:name=".ResetPage"
            android:exported="true" />
        <activity android:name=".SignupPage"
            android:exported="true" />
        <activity android:name=".LobbyPage"
            android:exported="true" />
        <activity android:name=".ScoreboardPage"
            android:exported="true" />
        <activity android:name=".Game1"
            android:exported="true" />
        <activity android:name=".Game2"
            android:exported="true" />
        <activity android:name=".Game3"
            android:exported="true" />
        <activity android:name=".Game4"
            android:exported="true" />
        <activity android:name=".Game5"
            android:exported="true" />
        <activity android:name=".Game6"
            android:exported="true" />
        <activity android:name=".Game7"
            android:exported="true" />
        <activity android:name=".Game8"
            android:exported="true" />
        <service android:name=".BackgroundMusic" />
    </application>


</manifest>