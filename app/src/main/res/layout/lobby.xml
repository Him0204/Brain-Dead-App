<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".LobbyPage">


    <LinearLayout
        android:id='@+id/player'
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingLeft="5dp"
        android:orientation="horizontal">

        <TextView
            android:id='@+id/hello'
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@string/hello"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold">

        </TextView>

        <TextView
            android:id='@+id/username'
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text=" *Username*"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold">

        </TextView>

    </LinearLayout>


    <ImageView
        android:id="@+id/rectangle"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginTop="20dp"
        android:layout_below="@id/player"
        android:src="@drawable/rectangle"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="20dp"
        android:layout_below="@id/player">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id='@+id/rpTitle'
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/rank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rank"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/point"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Points"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_weight="1" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id='@+id/rpContent'
                android:layout_below="@id/rpTitle"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="35dp"/>

                <ImageView
                    android:id="@+id/rankIcon"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/rank"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:id="@+id/rank_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_123"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/pointIcon"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/point"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:id="@+id/point_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_123"
                    android:layout_gravity="center_vertical"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:layout_weight="1"/>

            </LinearLayout>

            <Button
                android:id="@+id/button_scoreboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_rectangle"
                android:text="@string/scoreboard"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true" />


        </RelativeLayout>
    </LinearLayout>


    <Button
        android:id="@+id/button_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:background="@drawable/button_rectangle"
        android:text="Continue" />


    <TextView
        android:id="@+id/level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_above="@id/button_continue"
        android:layout_marginBottom="30dp"
        android:text="@string/level_xx"
        android:textColor="#536872"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/level"
        android:layout_centerHorizontal="true"
        android:text="@string/progress"
        android:textColor="@color/black"
        android:textSize="30sp"
        android:textStyle="bold" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true">

        <ImageView
            android:id="@+id/boy_photo"
            android:layout_width="150dp"
            android:layout_height="133dp"
            android:src="@drawable/boy_head"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="35dp"
            tools:layout_editor_absoluteY="127dp" />

        <ImageView
            android:id="@+id/message_bubble_photo"
            android:layout_width="314dp"
            android:layout_height="159dp"
            android:src="@drawable/message_bubble"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="-29dp"
            tools:layout_editor_absoluteY="-8dp" />

        <TextView
            android:id="@+id/boy_message"
            android:layout_width="146dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/boy_message"
            android:textColor="@color/black"
            android:textSize="25sp"
            android:textStyle="bold"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="72dp"
            tools:layout_editor_absoluteY="43dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</RelativeLayout>