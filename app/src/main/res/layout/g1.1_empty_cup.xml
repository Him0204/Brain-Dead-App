<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game"
    tools:context=".empty_cup">

    <TextView
        android:id="@+id/textView_cup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:layout_centerHorizontal="true"
        android:text="1. Fill the cup to the top"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/imageButton_home"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="90dp"
        android:layout_marginStart="20dp"
        android:background="@android:drawable/screen_background_light"
        android:scaleType="fitCenter"
        android:src="@drawable/setting_home" />

    <ImageButton
        android:id="@+id/imageButton_sound"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="90dp"
        android:layout_marginLeft="15dp"
        android:layout_toRightOf="@+id/imageButton_home"
        android:background="@android:drawable/screen_background_light"
        android:scaleType="fitCenter"
        android:src="@drawable/setting_speaker" />

    <ImageButton
        android:id="@+id/imageButton_hint"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="90dp"
        android:layout_marginLeft="15dp"
        android:layout_toRightOf="@+id/imageButton_sound"
        android:background="@android:drawable/screen_background_light"
        android:scaleType="fitCenter"
        android:src="@drawable/setting_hint" />

    <ImageButton
        android:id="@+id/imageButton_reset"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="90dp"
        android:layout_marginLeft="15dp"
        android:layout_toRightOf="@+id/imageButton_hint"
        android:background="@android:drawable/screen_background_light"
        android:scaleType="fitCenter"
        android:src="@drawable/setting_reset" />

    <ImageButton
        android:id="@+id/imageButton_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="90dp"
        android:layout_marginLeft="15dp"
        android:layout_toRightOf="@+id/imageButton_reset"
        android:background="@android:drawable/screen_background_light"
        android:scaleType="fitCenter"
        android:src="@drawable/setting_next" />

    <ImageButton
        android:id="@+id/imageButton_EmptyCup"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"
        android:layout_marginStart="58dp"
        android:layout_marginBottom="174dp"
        android:background="?android:attr/activatedBackgroundIndicator"
        android:scaleType="fitCenter"
        android:src="@drawable/g1_empty_cup" />

    <ImageButton
        android:id="@+id/imageButton_kettle"
        android:layout_width="wrap_content"
        android:layout_height="200dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"
        android:layout_marginStart="131dp"
        android:layout_marginEnd="-21dp"
        android:layout_marginBottom="242dp"
        android:background="?android:attr/activatedBackgroundIndicator"
        android:scaleType="fitCenter"
        android:src="@drawable/g1_kettle" />

</RelativeLayout>